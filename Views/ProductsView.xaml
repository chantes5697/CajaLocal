<UserControl x:Class="CajaLocal.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="Catálogo de productos" FontSize="23" FontWeight="Bold" Foreground="#172033" />
            <TextBlock Text="Agrega y modifica los productos que estarán disponibles en caja." Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4,0,4,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Código / SKU" Foreground="#475569" Margin="5,0,0,0" />
                    <TextBox x:Name="SkuBox" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Nombre del producto" Foreground="#475569" Margin="5,0,0,0" />
                    <TextBox x:Name="NameBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Precio (MXN)" Foreground="#475569" Margin="5,0,0,0" />
                    <TextBox x:Name="PriceBox" />
                </StackPanel>
                <Button Grid.Column="3" Content="Guardar" VerticalAlignment="Bottom" Click="Save_Click" />
                <Button Grid.Column="4" Content="Limpiar" Background="#64748B" VerticalAlignment="Bottom" Click="Clear_Click" />
                <Button Grid.Column="5" Content="Eliminar" Background="#B91C1C" VerticalAlignment="Bottom" Click="Delete_Click" />
            </Grid>
        </Border>

        <DataGrid x:Name="ProductsGrid" Grid.Row="2" IsReadOnly="True" SelectionChanged="ProductsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="150" />
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="150" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
