<UserControl x:Class="CajaLocal.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="PosView_IsVisibleChanged">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="4,2,4,8">
                    <TextBlock Text="Catálogo" FontSize="21" FontWeight="Bold" Foreground="#172033" />
                    <TextBlock Text="Selecciona un producto y agrégalo a la venta." Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="SearchBox" Height="40" FontSize="15" ToolTip="Buscar por código o nombre"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <DataGrid Grid.Row="2" x:Name="ProductsGrid" IsReadOnly="True" SelectionMode="Single"
                          MouseDoubleClick="ProductsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="120" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="3" Content="Agregar producto seleccionado" Height="45" Click="AddProduct_Click" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="4,2,4,8">
                    <TextBlock Text="Venta actual" FontSize="21" FontWeight="Bold" Foreground="#172033" />
                    <TextBlock Text="Ajusta las cantidades antes de cobrar." Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="CartGrid" SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Cant." Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="100" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,4">
                    <Button Content="Quitar seleccionado" Background="#64748B" Click="RemoveLine_Click" />
                    <Button Content="Vaciar" Background="#B91C1C" Click="ClearCart_Click" />
                </StackPanel>
                <Border Grid.Row="3" Background="#F0FDFA" CornerRadius="8" Padding="12" Margin="4">
                    <DockPanel>
                        <TextBlock Text="TOTAL" FontSize="18" FontWeight="Bold" Foreground="#115E59" />
                        <TextBlock x:Name="TotalText" Text="$0.00" FontSize="27" FontWeight="Bold"
                                   Foreground="#115E59" DockPanel.Dock="Right" />
                    </DockPanel>
                </Border>
                <Grid Grid.Row="4" Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Efectivo recibido" Foreground="#475569" Margin="4,0" />
                        <TextBox x:Name="CashBox" FontSize="18" TextChanged="CashBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cambio" Foreground="#475569" Margin="4,0" />
                        <TextBlock x:Name="ChangeText" Text="$0.00" FontSize="20" FontWeight="Bold"
                                   Foreground="#0F766E" Margin="8,9" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="5" Content="COBRAR Y GUARDAR VENTA" Height="58" FontSize="17"
                        Margin="4,12,4,4" Click="Checkout_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
