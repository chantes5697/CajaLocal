<Window x:Class="CajaLocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CajaLocal.Views"
        Title="Caja Local | Punto de venta"
        Height="820" Width="1320" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A43" CornerRadius="12" Padding="20" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CAJA LOCAL" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Punto de venta sin conexión" Foreground="#B8C7D9" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Text="VENTAS  ·  PRODUCTOS  ·  REPORTES" Foreground="#D8E2EC"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0">
            <TabItem Header="Punto de venta">
                <views:PosView />
            </TabItem>
            <TabItem Header="Productos">
                <views:ProductsView />
            </TabItem>
            <TabItem Header="Ventas">
                <views:SalesView />
            </TabItem>
            <TabItem Header="Configuración">
                <views:SettingsView />
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="4,10,4,0">
            <TextBlock Text="Modo local: los datos se guardan en este equipo." Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Caja Local v1.0" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
